# Robinhood Chain RPC used by the server and the /api/rpc proxy.
# Locally behind an ISP that blocks robinhood.com DNS: https://rentnode.org/api/rpc
RH_RPC=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_TOKEN_ADDRESS=0x000000000000000000000000000000000000dEaD
NEXT_PUBLIC_TOKEN_SYMBOL=TOKEN
NEXT_PUBLIC_POOL_ADDRESS=
# hot key that signs publish(); only ever holds gas money
PUBLISHER_KEY=
# shared secret the hourly cron sends as "authorization: Bearer <secret>"
CRON_SECRET=
# leave empty locally to use data/kv.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
